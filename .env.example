# ── Wallet ────────────────────────────────────────────────────────────────────
WALLET_PRIVATE_KEY=your_base58_private_key_here

# ── Solana RPC ─────────────────────────────────────────────────────────────────
# Helius mainnet RPC. Format: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Option A: OpenRouter (default)
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here

# Option B: LM Studio (local) — uncomment these and comment out OPENROUTER_API_KEY
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=your-model-name-from-lmstudio

# ── API Keys ───────────────────────────────────────────────────────────────────
# BARE key only (uuid) — never paste the full RPC URL here (causes HTTP 401).
HELIUS_API_KEY=your_helius_api_key_here
LPAGENT_API_KEY=your_lpagent_api_key_here

# ── Transaction sending (priority fee + expired-blockhash retries) ────────────
# Priority fee attached to every locally-signed transaction (DLMM deploy, claim,
# close and the SOL -> token zap) via ComputeBudget setComputeUnitPrice.
# Unit: micro-lamports per compute unit. 0 disables the instruction.
TX_PRIORITY_FEE_MICRO_LAMPORTS=50000
# Optional compute-unit ceiling (0 = leave the runtime default).
TX_COMPUTE_UNIT_LIMIT=0
# Retries after "signature expired: block height exceeded" — each retry fetches
# a fresh blockhash, re-signs and re-broadcasts. Clamped to 0-3.
TX_SEND_RETRIES=3
# Base delay between those retries (milliseconds).
TX_RETRY_DELAY_MS=400

# ── Jupiter referral fee (optional, DISABLED by default) ──────────────────────
# Referral fees are OFF unless BOTH values below are set to a valid referral
# account and a fee in BPS (Jupiter Ultra requires 50–255). While disabled, the
# bot attaches NO referralAccount / referralFee to any Jupiter quote or swap.
# JUPITER_REFERRAL_ACCOUNT=your_referral_account_public_key
# JUPITER_REFERRAL_FEE_BPS=0

# ── RPC fallback (optional, read-only) ────────────────────────────────────────
# Used only for health/balance reads when the primary RPC fails.
ENABLE_PUBLIC_RPC_FALLBACK=false
# RPC_FALLBACK_URL=https://api.mainnet-beta.solana.com

# ── Telegram Notifications (optional) ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# ── Dangerous admin actions (disabled by default) ─────────────────────────────
ALLOW_SELF_UPDATE=false

# ── Live trading gate (defense in depth) ──────────────────────────────────────
# Both deployPosition (autonomous) and openDlmmPosition (Telegram /lp menu)
# refuse LIVE mode unless DRY_RUN=true OR this is exactly "true".
# Leave false; enable only for a deliberate, supervised live session.
ENABLE_LIVE_TRADING=false

# ── Misc ───────────────────────────────────────────────────────────────────────
DRY_RUN=false
LOG_LEVEL=info
